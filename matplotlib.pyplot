   "source": [
    "# BAR CHHART\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "categories=['A' 'B' 'C' 'D']\n",
    "values=[5,7,3,8]\n",
    "\n",
    "plt.bar(categories, values)\n",
    "plt.title(\"Bar Chart\")\n",
    "plt.xlable(\"Categories\")\n",
    "plt.ylable(\"Values\")\n",
    "plt.show()\n"
   ]
  },
