    "#box plot\n",
    "import matplotlib.pyplot as plt\n",
    "data = [10, 20, 30, 40, 50, 100]\n",
    "plt.boxplot(data)\n",
    "plt.title(\"Box Plot\")\n",
    "plt.show()"
