   "source": [
    "# STACKED BAR CHART\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = ['A', 'B', 'C']\n",
    "y1 = [3, 5, 2]\n",
    "y2 = [4, 6, 3]\n",
    "\n",
    "plt.bar(x, y1, label='Data1')\n",
    "plt.bar(x, y2, bottom=y1, label='Data2')\n",
    "\n",
    "plt.title(\"Stacked Bar Chart\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
