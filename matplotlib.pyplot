    "#area plot \n",
    "import matplotlib.pyplot as plt\n",
    "x=[1, 2, 3, 4]\n",
    "y=[10, 20, 15, 25]\n",
    "plt.fill_between(x, y)\n",
    "plt.title(\"Area Plot\")\n",
    "plt.xlabel(\"X-axis\")\n",
    "plt.ylabel(\"Y-axis\")\n",
    "plt.show()"
   ]
