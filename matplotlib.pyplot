   "source": [
    "# Stem plot \n",
    "import matplotlib.pyplot as plt\n",
    "x = [1, 2, 3, 4]\n",
    "y = [5, 15, 10, 20]\n",
    "plt.stem(x,y)\n",
    "plt.title(\"Stem Plot\")\n",
    "plt.xlabel(\"X-axis\")\n",
    "plt.ylabel(\"Y-axis\")\n",
    "plt.show()"
   ]
