    "# HISTOGRAM\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data=[1,2,2,3,3,3,4,4,4,4]\n",
    "\n",
    "plt.hist(data, bins=4)\n",
    "plt.title(\"Histogram\")\n",
    "plt.xlabel(\"Values\")\n",
    "plt.ylabel(\"Freequency\")\n",
    "plt.show()"
   ]
  },
