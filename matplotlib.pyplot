   "source": [
    "# LINE PLOT\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x=[1,2,3,4]\n",
    "y=[10,20,30,40]\n",
    "plt.plot(x,y)\n",
    "plt.title(\"Line Plot\")\n",
    "plt.xlabel(\"x-axis\")\n",
    "plt.ylabel(\"y-axis\")\n",
    "plt.show()"
   ]
  },
